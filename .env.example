# Copy this file to .env and fill in the values. Never commit .env.

# Required: your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: Groq model name (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Docker image used for the code sandbox
# (build it with: docker build -t autodebug-sandbox:2 .)
CODEPILOT_SANDBOX_IMAGE=autodebug-sandbox:2

# Optional: where the Streamlit frontend finds the backend
CODEPILOT_API_URL=http://127.0.0.1:8000
